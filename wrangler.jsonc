{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xautomation",
  "compatibility_date": "2026-08-11",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xautomation-db",
      "database_id": "f62a591d-64cc-4158-95d9-a911b2f77605"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "xautomation-images"
    }
  ]
}
